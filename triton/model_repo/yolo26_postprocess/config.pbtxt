name: "yolo26_postprocess"
backend: "python"
max_batch_size: 1

input [
  {
    name: "raw_output"
    data_type: TYPE_FP32
    dims: [300, 6]
  }
]

output [
  {
    name: "output_labels"
    data_type: TYPE_INT64
    dims: [300]
  },
  {
    name: "output_scores"
    data_type: TYPE_FP32
    dims: [300]
  },
  {
    name: "output_boxes"
    data_type: TYPE_FP32
    dims: [300, 4]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]
