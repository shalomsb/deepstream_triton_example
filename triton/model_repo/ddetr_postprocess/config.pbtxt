name: "ddetr_postprocess"
backend: "python"
max_batch_size: 1
input [    
  {
    name: "res_logits"
    data_type: TYPE_FP32
    dims: [300, 91]
  }, 
  {
    name: "res_boxes"
    data_type: TYPE_FP32
    dims: [300, 4]
  }
] 
output [
  {
    name: "output_labels"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "output_scores"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "output_boxes"
    data_type: TYPE_FP32
    dims: [ -1, 4 ]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
    # gpus: 0
  }
]