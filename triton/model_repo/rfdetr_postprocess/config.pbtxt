name: "rfdetr_postprocess"
backend: "python"
max_batch_size: 8

input [
  {
    name: "dets"
    data_type: TYPE_FP32
    dims: [300, 4]
  },
  {
    name: "labels"
    data_type: TYPE_FP32
    dims: [300, 91]
  }
]

output [
  {
    name: "ensemble_labels"
    data_type: TYPE_INT64
    dims: [300]
  },
  {
    name: "ensemble_scores"
    data_type: TYPE_FP32
    dims: [300]
  },
  {
    name: "ensemble_boxes"
    data_type: TYPE_FP32
    dims: [300, 4]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
    gpus: [0]
  }
]

parameters: [
  { key: "FORCE_CPU_ONLY_INPUT_TENSORS"  value: { string_value: "no" } },
  { key: "FORCE_CPU_ONLY_OUTPUT_TENSORS" value: { string_value: "no" } }
]
