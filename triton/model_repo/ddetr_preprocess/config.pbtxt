name: "ddetr_preprocess"
platform: "tensorrt_plan"
max_batch_size: 1

input [
  {
    name: "input_images"
    data_type: TYPE_UINT8
    dims: [3, 1080, 1920]
  }
]

output [
  {
    name: "preprocessed_image"
    data_type: TYPE_FP32
    dims: [3, 544, 960]
  }
]

instance_group {
  count: 1
  gpus: 0
  kind: KIND_GPU
}
