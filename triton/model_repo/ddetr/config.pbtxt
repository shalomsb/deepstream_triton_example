name: "ddetr"
platform: "tensorrt_plan"
max_batch_size: 1

input [
  {
    name: "inputs"
    data_type: TYPE_FP32
    dims: [3, 544, 960]
  }
]

output [
  {
    name: "pred_logits"
    data_type: TYPE_FP32
    dims: [300, 91]
  }, 
  {
    name: "pred_boxes"
    data_type: TYPE_FP32
    dims: [300, 4]
  }
]

instance_group {
  count: 1
  gpus: 0
  kind: KIND_GPU
}
